---
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section class="section section--tint" id="products">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">ผลิตภัณฑ์ของบริษัท</span>
      <h2 class="section-title">ผลิตภัณฑ์ดูแลผิวหนังและสุขภาพสัตว์เลี้ยง</h2>
      <p>ครบทุกกลุ่มผลิตภัณฑ์ คิดค้นและพัฒนาโดยทีมสัตวแพทย์</p>
    </div>

    <nav class="product-nav reveal" aria-label="กลุ่มผลิตภัณฑ์">
      {
        products
          .filter((p) => p.data.logo)
          .map((p) => (
            <a class={`product-nav__card product-nav__card--${p.data.theme}`} href={`#${p.id}`}>
              <img src={p.data.logo} alt={p.data.title} width="260" height="98" />
            </a>
          ))
      }
    </nav>

  </div>

  <div class="products">
    {
      products.map((p) => (
        <article class={`product product--${p.data.theme}`} id={p.id}>
          <div class="product__band product__band--intro">
            <div class="container product__intro reveal">
              {p.data.headerImage && (
                <img class="product__header" src={p.data.headerImage} alt={p.data.title} />
              )}
              {p.data.heroImage && (
                <img class="product__hero" src={p.data.heroImage} alt={p.data.title} loading="lazy" />
              )}
              <h3 class="product__name">
                <span class="sr-only">{p.data.title}: </span>
                {p.data.subtitle ?? p.data.title}
              </h3>
              <p class="product__desc">{p.data.intro}</p>
              <div class="product__badges">
                {p.data.badges.map((b) => (
                  <img src={b} alt="" width="72" height="72" loading="lazy" />
                ))}
              </div>
              {p.data.brochure && (
                <a class="btn btn--ghost product__brochure" href={p.data.brochure} target="_blank" rel="noopener">
                  ดาวน์โหลดแผ่นพับ
                </a>
              )}
            </div>
          </div>

          {p.data.items.length > 0 && (
            <div class="product__band product__band--list">
              <div class="container reveal">
                <h3 class="product__products">Products</h3>
                <div class="slider">
                  <div class="product__items" tabindex="0" aria-label={`สินค้าในกลุ่ม ${p.data.title}`}>
                    {p.data.items.map((it) => (
                      <div class="item-card">
                        {it.image && <img class="item-card__img" src={it.image} alt={it.name} loading="lazy" />}
                        {it.banner && <img class="item-card__banner" src={it.banner} alt="" loading="lazy" />}
                        {it.size && <span class="item-card__size">{it.size}</span>}
                        <h4 class={`item-card__name${it.hideName ? ' sr-only' : ''}`}>{it.name}</h4>
                        <p class="item-card__desc">{it.description}</p>
                        {it.icons && <img class="item-card__icons" src={it.icons} alt="" loading="lazy" />}
                        {it.extras.map((x) => <img class="item-card__extra" src={x} alt="" loading="lazy" />)}
                      </div>
                    ))}
                  </div>
                  <button type="button" class="slider__btn slider__btn--prev" aria-label="ก่อนหน้า">‹</button>
                  <button type="button" class="slider__btn slider__btn--next" aria-label="ถัดไป">›</button>
                </div>
              </div>
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach((slider) => {
    const track = slider.querySelector<HTMLElement>('.product__items')!;
    const prev = slider.querySelector<HTMLButtonElement>('.slider__btn--prev')!;
    const next = slider.querySelector<HTMLButtonElement>('.slider__btn--next')!;
    const step = () => (track.querySelector<HTMLElement>('.item-card')?.offsetWidth ?? 280) + 19;

    // การ์ดพอดีหน้าจอ ไม่ต้องเลื่อน: ซ่อนปุ่ม/ไม่เลื่อนอัตโนมัติ และจัดกึ่งกลาง
    if (track.scrollWidth <= track.clientWidth + 2) {
      slider.classList.add('is-static');
      return;
    }

    const atStart = () => track.scrollLeft <= 2;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;

    // เลื่อนวนลูป: ถึงท้ายสุดแล้วกลับไปต้น / ถึงต้นแล้วย้อนไปท้าย
    const go = (dir: 1 | -1) => {
      if (dir === 1 && atEnd()) track.scrollTo({ left: 0 });
      else if (dir === -1 && atStart()) track.scrollTo({ left: track.scrollWidth });
      else track.scrollBy({ left: dir * step() });
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));

    // เลื่อนอัตโนมัติ (หยุดเมื่อ hover/โฟกัส/สัมผัส, ไม่ทำงานถ้าผู้ใช้ปิด animation)
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const DELAY = 3500;
    let timer: number | undefined;
    let visible = false;
    const stop = () => { clearInterval(timer); timer = undefined; };
    const start = () => {
      if (timer || !visible) return;
      timer = window.setInterval(() => go(1), DELAY);
    };

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      visible ? start() : stop();
    }, { threshold: 0.3 }).observe(slider);

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);
    slider.addEventListener('touchstart', stop, { passive: true });
    slider.addEventListener('touchend', () => setTimeout(start, DELAY), { passive: true });
  });
</script>

<style>
  /* ---------- Quick nav (คลิกเลื่อนไปแต่ละกลุ่ม) ---------- */
  .product-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-bottom: 3rem;
  }
  .product-nav__card {
    --accent: var(--c-primary);
    display: grid;
    place-items: center;
    padding: 1.5rem 1.25rem;
    background: #fff;
    border: 1px solid #e6eef5;
    border-radius: 18px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .product-nav__card--blue { --accent: var(--c-primary); }
  .product-nav__card--pink { --accent: #f06880; background: #f06880; border-color: #f06880; }
  .product-nav__card--yellow { --accent: var(--c-gold); }
  .product-nav__card img { max-height: 74px; width: auto; object-fit: contain; }
  .product-nav__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 34px rgba(8, 43, 73, 0.16);
    border-color: var(--accent);
  }

  #products { padding-bottom: 0; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  .products { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: 3rem; }
  .product { scroll-margin-top: 96px; }
  .product__band {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }
  /* รูปพื้นหลังโปร่งแสงซ้อนบนสีพื้น เหมือนเว็บเดิม */
  .product__band::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-img, none) var(--bg-pos, bottom center) / cover no-repeat;
    opacity: var(--bg-op, 1);
  }

  /* ----- Sensotop (blue): พื้นฟ้าน้ำเงินเกรนละเอียด ----- */
  .product--blue {
    --on: #fff;
    --title: #fff;
    --btn-bg: #fff;
    --btn-fg: var(--c-primary);
    --card-bg: linear-gradient(180deg, #fff 0%, #e4f1fa 100%);
  }
  .product--blue .product__band { background: #005381; }
  .product--blue .product__band--intro { --bg-img: url('/images/bg-sensotop-intro.webp'); --bg-op: 0.82; }
  .product--blue .product__band--list { --bg-img: url('/images/bg-sensotop-slider.webp'); --bg-op: 0.82; --bg-pos: top left; }

  /* ----- Aller Spot-On (pink): พื้นชมพูเมฆน้ำ ----- */
  .product--pink {
    --on: #005487;
    --title: #005487;
    --btn-bg: #ee94a0;
    --btn-fg: #fff;
    --card-bg: linear-gradient(180deg, #fff 0%, #ffe6ea 100%);
  }
  .product--pink .product__band--intro {
    background: linear-gradient(#ff5182, #fca7a7);
    --bg-img: url('/images/bg-aller-intro.webp');
    --bg-op: 0.67;
  }
  .product--pink .product__band--list { background: linear-gradient(#ff9f9f, #ffedf0); }

  /* ----- VC.AllerCare (yellow theme): พื้นชมพูอ่อน หัวข้อเทา ----- */
  .product--yellow {
    --on: #6f7073;
    --title: #ff7e94;
    --btn-bg: #ff7e94;
    --btn-fg: #fff;
    --card-bg: linear-gradient(180deg, #fff 0%, #fbe4ea 100%);
  }
  .product--yellow .product__band--intro {
    background: linear-gradient(#fdeef3, #f8c1c9);
    --bg-img: url('/images/bg-vc-intro.webp');
    --bg-op: 0.9;
  }
  .product--yellow .product__band--list { background: linear-gradient(#f1f1f1, #f8cad6); }

  .product__intro { text-align: center; max-width: 820px; }
  .product__header { margin: 0 auto 1.4rem; width: min(100%, 440px); height: auto; }
  .product__hero {
    margin: 0 auto 1.8rem;
    max-height: 420px;
    width: auto;
    filter: drop-shadow(0 14px 22px rgba(8, 43, 73, 0.25));
  }
  .product__name {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    line-height: 1.4;
    color: var(--on);
  }
  .product__desc { color: var(--on); margin: 1rem auto 1.4rem; }
  .product__badges { display: flex; justify-content: center; gap: 0.9rem; margin-bottom: 1.4rem; }
  .product__badges img { width: 72px; height: auto; }
  .product__brochure { color: var(--on); border-color: var(--on); }
  .product__brochure:hover { background: var(--on); color: var(--btn-bg); }

  .product__products {
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: var(--title);
    margin-bottom: 1.4rem;
  }

  .slider { position: relative; }
  .product__items {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-block: 0.4rem 0.8rem;
  }
  .product__items::-webkit-scrollbar { display: none; }
  .slider__btn {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--btn-bg, var(--accent));
    color: var(--btn-fg, #fff);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .slider__btn:hover { transform: scale(1.08); }
  .is-static .slider__btn { display: none; }
  .is-static .product__items { justify-content: center; }
  .slider__btn--prev { left: -10px; }
  .slider__btn--next { right: -10px; }
  .item-card {
    flex: 0 0 clamp(300px, 46%, 520px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 0;
    border-radius: 26px;
    padding: 2rem 1.6rem 1.6rem;
    box-shadow: 0 6px 22px rgba(8, 43, 73, 0.1);
    text-align: center;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .item-card:hover { transform: translateY(-4px); box-shadow: 0 14px 32px rgba(8, 43, 73, 0.16); }
  .item-card__img {
    height: clamp(220px, 28vw, 320px);
    width: 100%;
    margin: 0 auto 1.4rem;
    object-fit: contain;
    filter: drop-shadow(0 10px 14px rgba(8, 43, 73, 0.12));
  }
  .item-card__size {
    order: 1;
    font-size: 0.875rem;
    font-weight: 700;
    color: #005487;
    margin-bottom: 0.6rem;
  }
  .item-card__name { order: 2; font-size: 1.05rem; font-weight: 700; color: #005487; margin-bottom: 0.7rem; }
  .item-card__desc { order: 3; font-size: 0.875rem; line-height: 1.8; color: #005480; text-align: left; }
  .item-card__banner { order: 2; width: 100%; max-width: 340px; height: auto; margin: -0.4rem auto 0; }
  .item-card__extra { order: 5; width: 100%; height: auto; }
  .item-card__icons { order: 4; width: 100%; height: auto; margin-top: auto; padding-top: 1.4rem; }

  @media (max-width: 520px) {
    .item-card { flex-basis: 82%; }
    .slider__btn { display: none; }
    .product-nav { grid-template-columns: 1fr; gap: 0.9rem; }
    .product-nav__card { padding: 1.2rem; }
  }
</style>
